DB_HOST=localhost
DB_PORT=5432
DB_USER=user_grooming
DB_PASS=changeme
DB_NAME=grooming_db
# `true` para Neon/Supabase u otro Postgres gestionado con TLS obligatorio.
DB_SSL=false

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

DEMO_TENANT_TTL_HOURS=24

PORT=3001

# CORS_ORIGIN admite lista separada por comas. Cada entrada puede ser:
#   - URL exacta:          https://app.example.com
#   - Regex (entre `/`):   /^https:\/\/.*\.vercel\.app$/
#   - Comodín:             *
# Ejemplo prod (frontend en Vercel + previews):
#   CORS_ORIGIN=https://www.example.com,/^https:\/\/.*\.vercel\.app$/
CORS_ORIGIN=http://localhost:3000

# Spec 002 — WhatsApp deep-link + edición + fundador
# País por defecto para normalizar teléfonos a E.164 (ISO 3166 alpha-2).
DEFAULT_COUNTRY=CO

# Tenant fundador (persistente, no demo). Todas requeridas juntas o ninguna.
# Generar el hash con: node -e "console.log(require('bcryptjs').hashSync('TU_PASSWORD', 10))"
FOUNDER_EMAIL=
FOUNDER_PASSWORD_HASH=
FOUNDER_TENANT_NAME=

# Spec 003 — WhatsApp Cloud API (Meta Graph API)
# Si están vacíos, el sistema cae al flujo wa.me deep-link (semi-manual).
# Para activar envío automático real, configura los 4 valores.
# Genera el token en Meta App → WhatsApp → API Setup (temporal 24h o System User permanente).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v21.0
